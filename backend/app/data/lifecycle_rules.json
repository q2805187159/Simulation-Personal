{
  "schema_version": 1,
  "version": "lifecycle-scenarios/1",
  "rules": [
    {
      "id": "lifecycle-early-learning",
      "title": "形成入学前学习安排",
      "category": "development",
      "minimum_age": 4,
      "maximum_age": 4,
      "anchors": ["birth"],
      "condition": "先按家庭可用时间安排早期学习，具体机构和入园记录未知",
      "state_field": "early_learning_arrangement",
      "choices": ["跟随照料者练习说话和辨认常见物件", "由照料者安排讲故事和简单的数数练习"],
      "dimensions": [{"id": "DEV.07", "value_key": "activity", "unknown_fields": ["institution", "hours"]}]
    },
    {
      "id": "lifecycle-school-practice",
      "title": "建立在读阶段学习练习",
      "category": "education",
      "minimum_age": 10,
      "maximum_age": 14,
      "anchors": ["education"],
      "condition": "按基础教育活动安排阶段性练习，成绩、学历及学校名称未知",
      "state_field": "learning_practice",
      "choices": ["利用练习本整理课堂上的例题和错题", "和同伴轮流复述课堂内容并核对练习"],
      "dimensions": [{"id": "DAILY.05", "value_key": "activity", "unknown_fields": ["hours"]}]
    },
    {
      "id": "lifecycle-occupational-learning",
      "title": "补充实务学习",
      "category": "education",
      "minimum_age": 20,
      "maximum_age": 25,
      "anchors": ["school-path"],
      "condition": "按可获得的学习机会补充实务技能，培训证书与机构身份未知",
      "state_field": "practice_training",
      "choices": ["跟随经验较多的人反复练习一套操作流程", "以自行整理使用说明和反复练习为主"],
      "dimensions": [{"id": "EDU.07", "value_key": "activity", "unknown_fields": ["institution", "credential"]}]
    },
    {
      "id": "lifecycle-housing-review",
      "title": "评估下一阶段居住安排",
      "category": "housing",
      "minimum_age": 23,
      "maximum_age": 32,
      "anchors": ["commute-path"],
      "condition": "结合通勤、居住开支与可达住房重新比较选择，租住或产权结果未知",
      "state_field": "housing_review",
      "choices": ["优先评估留在当前住处并调整通勤路线", "优先调查更接近经常活动地点的住房"],
      "dimensions": [{"id": "HOUSING.08", "value_key": "preference", "unknown_fields": ["tenure", "actual_move"]}]
    },
    {
      "id": "lifecycle-reserve-plan",
      "title": "安排日常应急开支",
      "category": "finance",
      "minimum_age": 26,
      "maximum_age": 38,
      "anchors": ["budget-routine"],
      "condition": "用既有预算安排列出优先事项，储蓄额、贷款和实际到账未知",
      "state_field": "reserve_plan",
      "choices": ["预留一笔用于交通与生活用品的支出额度", "先保留必要开支，遇到临时需求时再调整其他安排"],
      "dimensions": [{"id": "INCOME.08", "value_key": "rule", "unknown_fields": ["amount", "currency"]}]
    },
    {
      "id": "lifecycle-family-coordination",
      "title": "与亲属协商日常事务",
      "category": "household",
      "minimum_age": 31,
      "maximum_age": 44,
      "anchors": ["support-plan"],
      "condition": "依据已有的家庭支持关系组织家务，具体同住状态与劳动时长未知",
      "state_field": "household_coordination",
      "household": "family",
      "participants": "anchor",
      "choices": ["提前协商采购和日常帮忙的分工", "遇到事务集中时再与亲属协调时间"],
      "dimensions": [{"id": "HOUSEHOLD.06", "value_key": "arrangement", "unknown_fields": ["hours", "co_residence"]}]
    },
    {
      "id": "lifecycle-neighbour-contact",
      "title": "调整邻里联系与互助方式",
      "category": "community",
      "minimum_age": 31,
      "maximum_age": 45,
      "anchors": ["community-contact"],
      "condition": "使用此前在生活半径内建立的接触，邻居身份和日常联系次数未知",
      "state_field": "neighbour_contact",
      "choices": ["在互相方便时交流附近办事地点和开放时间", "借常见的往来场合了解邻近居民是否需要临时帮忙"],
      "dimensions": [{"id": "COMMUNITY.05", "value_key": "contact", "unknown_fields": ["counterparty_id", "frequency"]}]
    },
    {
      "id": "lifecycle-preventive-information",
      "title": "查找日常保健信息",
      "category": "health",
      "minimum_age": 38,
      "maximum_age": 53,
      "anchors": ["daily-routine"],
      "condition": "日常健康维护路径仅包含寻找信息，实际体检、诊断和费用未知",
      "state_field": "preventive_health_information",
      "choices": ["向熟悉的医疗服务窗口询问日常保健信息", "阅读能够获得的保健指导并记录需要核对的问题"],
      "dimensions": [{"id": "KNOW.04", "value_key": "information_activity", "unknown_fields": ["screening_result", "medical_provider"]}]
    },
    {
      "id": "lifecycle-digital-tasks",
      "title": "用数字工具完成常见事务",
      "category": "digital",
      "minimum_age": 24,
      "maximum_age": 75,
      "anchors": ["digital-adoption"],
      "condition": "在形成接入方式之后练习具体操作，设备账户与时间用量未知",
      "state_field": "digital_task_practice",
      "choices": ["练习保存常用联系方式与查询办事指引", "在家人或熟人协助下练习查找所需信息"],
      "dimensions": [{"id": "DIGITAL.02", "value_key": "activity", "unknown_fields": ["proficiency", "frequency"]}]
    },
    {
      "id": "lifecycle-after-job-exit",
      "title": "调整离岗后的求职安排",
      "category": "work",
      "minimum_age": 18,
      "maximum_age": 75,
      "anchors": ["job-exit"],
      "latest_year_offset": 0,
      "condition": "该步骤以已经发生的离岗为前提，具体获聘单位和再就业结果未知",
      "state_field": "post_exit_plan",
      "choices": ["先向熟人了解附近可用工机会", "整理既有工作经验并查找岗位信息"],
      "dimensions": [{"id": "LIFECHANCE.07", "value_key": "action", "unknown_fields": ["employer", "hiring_outcome"]}]
    },
    {
      "id": "lifecycle-post-relocation",
      "title": "重建迁居后的办事路线",
      "category": "mobility",
      "minimum_age": 18,
      "maximum_age": 100,
      "anchors": ["relocation"],
      "latest_year_offset": 0,
      "location": "unknown",
      "condition": "此前已经迁居，具体目的地、户籍变动与使用公共服务的结果未知",
      "state_field": "post_move_mobility",
      "choices": ["先摸清新住处至常用服务点的路线", "询问熟人如何安排新住处周边的日常往返"],
      "dimensions": [{"id": "MOBILITY.04", "value_key": "arrangement", "unknown_fields": ["destination", "route_duration"]}]
    },
    {
      "id": "lifecycle-care-review",
      "title": "与亲属复核后续照料安排",
      "category": "household",
      "minimum_age": 35,
      "maximum_age": 100,
      "anchors": ["shared-care"],
      "latest_year_offset": 1,
      "household": "family",
      "participants": "anchor",
      "condition": "沿用已经发生的共享照料关系，实际新增时数及健康结局未知",
      "state_field": "care_follow_up",
      "choices": ["保留原分工并约定遇到临时变化时重新协调", "核对亲属可投入的时间并讨论替换安排"],
      "dimensions": [{"id": "HOUSEHOLD.08", "value_key": "support_arrangement", "unknown_fields": ["hours", "outcome"]}]
    },
    {
      "id": "lifecycle-partner-coordination",
      "title": "与伴侣协调生活安排",
      "category": "household",
      "minimum_age": 20,
      "maximum_age": 92,
      "anchors": ["partnership"],
      "latest_year_offset": 2,
      "condition": "已有伴侣关系，登记、同居、财产安排和伴侣身份仍未知",
      "state_field": "partnership_coordination",
      "choices": ["按各自已有安排协商可以共同参与的事务", "先了解对方的日程再商议固定联络时间"],
      "dimensions": [{"id": "PARTNER.06", "value_key": "arrangement", "unknown_fields": ["partner_id", "co_residence"]}]
    },
    {
      "id": "lifecycle-later-service-access",
      "title": "核对后期生活服务可达性",
      "category": "community",
      "minimum_age": 62,
      "maximum_age": 76,
      "anchors": ["later-life"],
      "condition": "结合后期日程变化了解出行和服务条件，申请资格和实际服务获得情况未知",
      "state_field": "later_service_options",
      "choices": ["比较能自行前往的日常服务点与可由熟人协助的事项", "事先询问现有服务时间并调整安排"],
      "dimensions": [{"id": "LIFECHANCE.07", "value_key": "access_inquiry", "unknown_fields": ["provider", "accessibility_measure"]}]
    }
  ]
}
